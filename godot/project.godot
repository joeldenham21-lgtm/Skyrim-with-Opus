[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="entities"
3d_physics/layer_4="props"
3d_physics/layer_5="triggers"
3d_render/layer_1="world"
3d_render/layer_2="viewmodel"

[physics]
3d/default_gravity=22.0
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
scaling_3d/mode=2
scaling_3d/scale=0.77
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
global_illumination/sdfgi/probe_ray_count=1
environment/ssao/quality=2
environment/glow/upscale_mode=1
environment/volumetric_fog/volume_size=64
environment/volumetric_fog/volume_depth=64
textures/vram_compression/import_etc2_astc=true
