; RADIUS — Godot 4.5 project
config_version=5

[application]
config/name="RADIUS"
config/description="A first-person survival horror in the Pechorsk Restricted Zone."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
Events="*res://autoload/events.gd"
Data="*res://autoload/data.gd"
Clock="*res://autoload/clock.gd"
Audio="*res://autoload/audio.gd"
Director="*res://autoload/director.gd"
Game="*res://autoload/game.gd"

[debug]
gdscript/warnings/inference_on_variant=1
gdscript/warnings/get_node_default_without_onready=1
gdscript/warnings/native_method_override=1
gdscript/warnings/onready_with_export=1

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

